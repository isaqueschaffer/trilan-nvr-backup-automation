# =============================================================
# Configuração LOCAL para desenvolvimento
# Copie este arquivo para .env e ajuste conforme necessário
# =============================================================

# --- Banco de Dados ---
POSTGRES_DB=trilan_backup
POSTGRES_USER=trilan
POSTGRES_PASSWORD=trilan_local_2024

# --- API ---
DATABASE_URL=postgresql://trilan:trilan_local_2024@db:5432/trilan_backup

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=local_secret_key_troque_em_producao_0000000000000000000000000000

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=GERE_SUA_CHAVE_FERNET_AQUI_python_-c_from_cryptography.fernet_import_Fernet_print_Fernet.generate_key_decode

# Senha do painel administrativo (local)
ADMIN_PASSWORD=admin

# URL pública da API (usada para links nos e-mails — em local use localhost)
PUBLIC_URL=http://localhost:7001

# --- SMTP (opcional em local — deixe em branco para desativar e-mail) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
